# Кодировка по умолчанию. Без этого Apache отдаёт .txt и .md без charset,
# браузер откатывается на однобайтовую кодировку, и «Digitální růst»
# показывается как «DigitÃ¡lnÃ­ rÅ¯st». Заметно на llms.txt, где есть
# чешский, русский и украинский.
# AddDefaultCharset покрывает text/plain (llms.txt, robots.txt, security.txt)
# и text/html. Для text/markdown нужен отдельный AddCharset — он ниже.
AddDefaultCharset utf-8
AddCharset utf-8 .txt

# Tell Apache the MIME type for pre-generated markdown files.
# AddDefaultCharset действует только на text/plain и text/html, поэтому
# для text/markdown нужен явный AddCharset — иначе прямой запрос
# /index.md придёт без кодировки.
AddType text/markdown .md
AddCharset utf-8 .md

# Markdown content negotiation for AI agents (Accept: text/markdown)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # ─── Режим обслуживания ──────────────────────────────────────────────────
    # Включён 20 сентября 2026. Снимается удалением этого блока и блока
    # ErrorDocument/Retry-After сразу под ним — больше ничего трогать не надо.
    #
    # Весь сайт отвечает 503 с заглушкой /maintenance.html. Именно 503, а не
    # 404 и не 200 с текстом: поисковики читают его как «временно недоступен»,
    # страницы из индекса не выпадают, а Retry-After говорит, когда вернуться.
    #
    # Исключения: сама заглушка (иначе ErrorDocument зациклится), /fonts/ и
    # фавиконка — без них заглушка отрисуется системным шрифтом.
    #
    # Обход для своих: открыть https://webvam.cz/?key=29cd02e18820024f
    # Ставится cookie на сутки, и дальше боевой сайт виден целиком.
    RewriteCond %{QUERY_STRING} (^|&)key=29cd02e18820024f($|&)
    RewriteRule ^ - [CO=wv_bypass:29cd02e18820024f:webvam.cz:1440:/]

    RewriteCond %{HTTP_COOKIE} !wv_bypass=29cd02e18820024f
    RewriteCond %{QUERY_STRING} !(^|&)key=29cd02e18820024f($|&)
    RewriteCond %{REQUEST_URI} !^/maintenance\.html$
    RewriteCond %{REQUEST_URI} !^/fonts/
    RewriteCond %{REQUEST_URI} !^/favicon\.svg$
    RewriteRule ^ - [R=503,L,E=MAINT:1]

    # ─── Одна языковая версия (сентябрь 2026) ────────────────────────────────
    # Публикуется только русская, и она переехала из /ru/ в корень.
    # Правила стоят перед согласованием markdown: сначала приводим URL
    # к существующему, потом уже решаем, отдавать HTML или markdown.

    # Страницы услуг по технологиям (сентябрь 2026) заменены страницами
    # по адресатам: церковь, служение, член церкви. Точной пары у старых
    # адресов нет, поэтому они ведут на список. Стоит до правила /ru/,
    # чтобы /ru/uslugi/… уходил сюда одним переходом, а не двумя.
    RewriteRule ^(ru/)?uslugi/(staticheskie-sajty|cms-sajty)(/.*)?$ /uslugi/ [R=301,L]

    # Русские страницы: /ru/uslugi/ → /uslugi/, постранично, чтобы не терять
    # позиции по каждому адресу отдельно.
    RewriteRule ^ru$ /  [R=301,L]
    RewriteRule ^ru/$ / [R=301,L]
    RewriteRule ^ru/(.+)$ /$1 [R=301,L]

    # Чешская, украинская и английская версии сняты с публикации целиком —
    # весь их трафик уходит на русскую главную.
    RewriteRule ^(uk|en)(/.*)?$ / [R=301,L]

    # Чешская версия жила без префикса, поэтому её разделы перечислены явно.
    # /portfolio/ и /kontakt/ здесь нет: эти адреса совпадают с русскими
    # и теперь отдают русскую страницу.
    RewriteRule ^(sluzby|dekujeme|zasady-ochrany-osobnich-udaju)(/.*)?$ / [R=301,L]

    # Корень сайта. Внутри .htaccess путь запроса «/» — пустая строка, а
    # правило ниже требует слэш на конце, поэтому главную оно не ловило.
    # Из-за этого главная была единственной страницей, отдававшей HTML
    # вместо markdown, и проверяльщики агентов, которые тестируют именно
    # её, считали согласование выключенным на всём сайте.
    RewriteCond %{HTTP_ACCEPT} text/markdown
    RewriteCond %{DOCUMENT_ROOT}/index.md -f
    RewriteRule ^$ index.md [L,E=SERVE_MARKDOWN:1]

    # Каталоги: /uslugi/, /portfolio/ и так далее
    RewriteCond %{HTTP_ACCEPT} text/markdown
    RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}index.md -f
    RewriteRule ^(.*/)$ $1index.md [L,E=SERVE_MARKDOWN:1]

    # Non-directory requests without extension: /uslugi, /uslugi/seo-optimizaciya
    RewriteCond %{HTTP_ACCEPT} text/markdown
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.md -f
    RewriteRule ^([^.]+[^/])$ $1/index.md [L,E=SERVE_MARKDOWN:1]
</IfModule>

# ─── Режим обслуживания: тело ответа и заголовки ─────────────────────────────
# Снимается вместе с блоком выше.
ErrorDocument 503 /maintenance.html
<IfModule mod_headers.c>
    # MAINT ставит RewriteRule; после внутреннего перехода на ErrorDocument
    # переменная получает префикс REDIRECT_, поэтому проверяем оба имени.
    Header always set Retry-After "3600" env=MAINT
    Header always set Retry-After "3600" env=REDIRECT_MAINT
    # Заглушку нельзя отдавать из кэша: сайт вернётся раньше, чем истечёт TTL.
    Header always set Cache-Control "no-store" env=MAINT
    Header always set Cache-Control "no-store" env=REDIRECT_MAINT
</IfModule>

# Correct Content-Type for extensionless api-catalog and typed OpenAPI file
<FilesMatch "^api-catalog$">
    Header always set Content-Type "application/linkset+json"
</FilesMatch>
<FilesMatch "^openapi\.json$">
    Header always set Content-Type "application/openapi+json"
</FilesMatch>

# CORS for MCP server-card so browser-based agents can fetch it cross-origin
<FilesMatch "^server-card\.json$">
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type"
</FilesMatch>

<IfModule mod_headers.c>
    # RFC 8288 Web Linking — agent discovery
    Header always set Link "</llms.txt>; rel=\"describedby\", </.well-known/api-catalog>; rel=\"api-catalog\", </.well-known/mcp/server-card.json>; rel=\"service-desc\" type=\"application/json\", </.well-known/security.txt>; rel=\"security.txt\", </sitemap.xml>; rel=\"sitemap\""

    # Vary: Accept so HTTP caches serve the right format per client type
    Header always set Vary "Accept"

    # Correct Content-Type for markdown responses (overrides mod_mime if needed)
    Header always set Content-Type "text/markdown; charset=utf-8" env=SERVE_MARKDOWN
</IfModule>

# ─── Кэширование ─────────────────────────────────────────────────────────────
# CSS и JS отдаются с хэшем содержимого в имени (Hugo fingerprint), поэтому их
# можно кэшировать навсегда: при изменении меняется имя файла. Без этих
# заголовков хэш в имени не даёт ничего.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType font/woff2               "access plus 1 year"
    ExpiresByType image/webp               "access plus 6 months"
    ExpiresByType image/jpeg               "access plus 6 months"
    ExpiresByType image/png                "access plus 6 months"
    ExpiresByType image/svg+xml            "access plus 6 months"
    # HTML и машиночитаемые файлы должны обновляться сразу
    ExpiresByType text/html                "access plus 0 seconds"
    ExpiresByType text/plain               "access plus 0 seconds"
    ExpiresByType text/markdown            "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # Файлы с хэшем содержимого в имени — immutable
    <FilesMatch "\.(min\.[0-9a-f]{64}|[0-9a-f]{64})\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.woff2$">
        Header set Cache-Control "public, max-age=31536000, immutable"
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
    # llms.txt и markdown-версии — всегда свежие, их читают агенты
    <FilesMatch "^llms\.txt$|\.md$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>
